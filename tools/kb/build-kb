#!/usr/bin/env bash
# Génère la base de connaissance ULTIMA depuis le jeu installé (LECTURE SEULE sur le jeu).
# Sortie hors dépôt (textes MegaCrit, jamais commités) : ~/.local/share/ultima/kb/ par défaut.
#
#   tools/kb/build-kb [--game <dir>] [--catalog <dir>] [--out <dir>] [--game-version v0.107.1]
#
# Défauts : --game  $ULTIMA_GAME_DIR ou /home/mio/sts2/game
#           --catalog <dépôt>/data/catalog
#           --out   ${XDG_DATA_HOME:-~/.local/share}/ultima/kb
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
game="${ULTIMA_GAME_DIR:-/home/mio/sts2/game}"
catalog="$repo/data/catalog"
out="${XDG_DATA_HOME:-$HOME/.local/share}/ultima/kb"
version="v0.107.1"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --game) game="$2"; shift 2;;
    --catalog) catalog="$2"; shift 2;;
    --out) out="$2"; shift 2;;
    --game-version) version="$2"; shift 2;;
    -h|--help) sed -n '2,10p' "$0"; exit 0;;
    *) echo "build-kb : argument inconnu $1" >&2; exit 2;;
  esac
done
case "$(realpath -m "$out")/" in
  "$repo"/*) echo "build-kb : refus d'écrire dans le dépôt ($out) — textes du jeu, jamais commités" >&2; exit 2;;
esac
dotnet run --project "$here/KbBuild/KbBuild.csproj" -c Release -v q -- \
  --game "$game" --catalog "$catalog" --out "$out" --game-version "$version"
