# ULTIMA toolchain — Fedora + .NET 9/10 + décompilation STS2.
# Build : podman build -t ultima-toolchain:local -f containers/Containerfile .
# Usage : podman run --rm -v $PWD:/work:z -w /work ultima-toolchain:local dotnet test ...
FROM fedora:latest

ENV DOTNET_ROOT=/usr/local/dotnet
ENV PATH=/usr/local/dotnet:/usr/local/dotnet/tools:$PATH
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1
ENV NUGET_PACKAGES=/root/.nuget/packages

# Dépendances système minimales (pas de sudo : on est root dans l'image)
RUN dnf install -y --setopt=install_weak_deps=False \
        curl libicu tar gzip unzip which git python3 python3-pip jq rsync findutils procps-ng \
    && dnf clean all

# .NET SDK 10 (nécessaire à ilspycmd >= 11) + SDK 9 (cible du mod, net9.0)
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel 9.0 --install-dir "$DOTNET_ROOT" --no-path \
    && bash /tmp/dotnet-install.sh --channel 10.0 --install-dir "$DOTNET_ROOT" --no-path \
    && rm -f /tmp/dotnet-install.sh \
    && dotnet --list-sdks

# ilspycmd (décompilation C#)
# --tool-path explicite : `--global` installe dans $HOME/.dotnet/tools (/root/...),
# qui n'est pas dans le PATH de l'image. On cible le dossier déjà présent dans PATH.
RUN dotnet tool install --tool-path /usr/local/dotnet/tools ilspycmd \
 && /usr/local/dotnet/tools/ilspycmd --version

# GDRE Tools (extraction du .pck Godot) — binaire Linux headless
ARG GDRE_VERSION=2.7.4
RUN mkdir -p /opt/gdre \
    && curl -fsSL -o /tmp/gdre.zip \
       "https://github.com/GDRETools/gdsdecomp/releases/download/v${GDRE_VERSION}/GDRE_tools-v${GDRE_VERSION}-linux.zip" \
    && unzip -q /tmp/gdre.zip -d /opt/gdre \
    && rm -f /tmp/gdre.zip \
    && GDRE_BIN="$(find /opt/gdre -maxdepth 2 -type f -name 'gdre_tools*' ! -name '*.pck' | head -1)" \
    && echo "GDRE_BIN=$GDRE_BIN" \
    && chmod +x "$GDRE_BIN" \
    && ln -sf "$GDRE_BIN" /usr/local/bin/gdre_tools \
    && (gdre_tools --gdre-version || true)

# Node 22 (REA MCP) — optionnel mais présent pour `rea mcp doctor`
RUN dnf install -y --setopt=install_weak_deps=False nodejs npm && dnf clean all

WORKDIR /work
CMD ["bash"]
