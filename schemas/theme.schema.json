{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultima.local/schemas/theme.schema.json",
  "title": "Thème ULTIMA (docs/44 §4)",
  "type": "object",
  "required": [
    "id",
    "label",
    "api"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "label": {
      "type": "string",
      "maxLength": 40
    },
    "api": {
      "const": 1
    },
    "extends": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "tones": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "text",
          "muted",
          "accent",
          "danger",
          "ok",
          "warn",
          "curse",
          "enchant",
          "info",
          "grade.S",
          "grade.A",
          "grade.B",
          "grade.C",
          "grade.D",
          "grade.F",
          "background",
          "border"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
      }
    },
    "logColors": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "timestamp",
          "debug",
          "info",
          "warn",
          "error"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
          },
          {
            "type": "string",
            "enum": [
              "text",
              "muted",
              "accent",
              "danger",
              "ok",
              "warn",
              "curse",
              "enchant",
              "info",
              "grade.S",
              "grade.A",
              "grade.B",
              "grade.C",
              "grade.D",
              "grade.F",
              "background",
              "border"
            ]
          }
        ]
      }
    },
    "glass": {
      "type": "object",
      "properties": {
        "tint": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "tintOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "size": {
          "type": "integer",
          "minimum": 12,
          "maximum": 24
        }
      },
      "additionalProperties": false
    }
  }
}
